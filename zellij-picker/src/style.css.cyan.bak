/* Cyan-on-dark, matching ~/.config/rofi/colors.rasi and the Hyprland accent. */

window {
  background: transparent;
}

.root {
  background-color: rgba(17, 24, 31, 0.85);   /* @base      #11181f */
  border: 1px solid rgba(0, 255, 205, 0.33);  /* @cyan-soft #00ffcd55 */
  border-radius: 14px;
  padding: 18px;
  color: #d0fff7;                             /* @fg */
  font-family: "Adwaita Sans", sans-serif;
  font-size: 12pt;
}

entry {
  background-color: rgba(26, 36, 45, 0.93);   /* @surface   #1a242d */
  border: 1px solid rgba(0, 255, 205, 0.33);
  border-radius: 12px;
  padding: 9px 14px;
  min-height: 0;
  color: #d0fff7;
  caret-color: #00ffcd;
  box-shadow: none;
  outline: none;
}

entry:focus-within {
  border-color: #00ffcd;                      /* @cyan */
  background-color: rgba(0, 255, 205, 0.07);
}

entry > text > placeholder {
  color: #8a9a97;                             /* @fg-muted */
}

entry.error {
  border-color: #ff4d6d;                      /* @red */
}

.hint {
  color: #8a9a97;
  font-size: 10pt;
  padding: 0 6px;
}

/* ScrolledWindow wraps the (non-scrollable) ListBox in a viewport whose
   .view class carries the theme's solid background — clear the whole chain. */
scrolledwindow,
viewport,
.view,
list {
  background-color: transparent;
  background-image: none;
}

list > row {
  padding: 9px 14px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
}

list > row:selected {
  background-color: rgba(0, 255, 205, 0.13);  /* @cyan-dim */
  border-color: rgba(0, 255, 205, 0.33);
}

list > row:selected .name {
  color: #00ffcd;
}

.name {
  color: #d0fff7;
}

.meta {
  color: #8a9a97;
  font-size: 10pt;
}
