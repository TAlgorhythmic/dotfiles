;; ─────────────────────────────────────────────
;;  Mouse acceleration profile picker
;; ─────────────────────────────────────────────

;; Currently applied profile (set by set-accel.sh)
(defpoll active-profile :interval "2s" :initial "adaptive"
  `cat $HOME/.cache/accel_profile 2>/dev/null || echo adaptive`)

;; Keyboard-highlighted profile (driven by nav.sh via `eww update`)
(defvar selected "adaptive")

(defwidget profile-btn [id label desc icon key]
  (button :class {"profile" + (active-profile == id ? " active" : "") + (selected == id ? " focused" : "")}
          :onclick "$HOME/.config/eww/scripts/nav.sh apply ${id}"
    (box :orientation "h" :space-evenly false :spacing 12 :valign "center"
      (label :class "p-icon" :text icon)
      (box :orientation "v" :space-evenly false :spacing 2 :hexpand true
        (label :class "p-title" :text label :halign "start")
        (label :class "p-desc"  :text desc  :halign "start" :wrap true :limit-width 40))
      (label :class "p-key" :text key)
      (label :class "p-check" :text {active-profile == id ? "" : ""}))))

(defwidget accel-content []
  (box :class "menu" :orientation "v" :space-evenly false :spacing 10
    (box :class "header" :orientation "h" :space-evenly false :valign "center"
      (label :class "title" :text "󰍽  Mouse Acceleration" :hexpand true :halign "start")
      (button :class "close" :onclick "$HOME/.config/eww/scripts/nav.sh cancel" "✕"))
    (profile-btn :id "adaptive" :icon "󰓅" :key "1" :label "Adaptive"
      :desc "Hyprland libinput adaptive · sensitivity -0.2")
    (profile-btn :id "custom" :icon "󰳽" :key "2" :label "Custom Curve"
      :desc "Hyprland native custom curve (step 1.9)")
    (label :class "hint" :halign "center"
      :text "↑↓/jk move   ↵ select   1·2 jump   esc close")))

(defwindow accel-menu
  :monitor 0
  :stacking "overlay"
  :focusable true
  :geometry (geometry :x "0" :y "0" :width "360px" :anchor "center")
  (accel-content))
