/* ╔══════════════════════════════════════════════════════════════════╗
 * ║  colors.rasi — shared palette                                      ║
 * ║  Mirrors the Hyprland / hyprlock accent theme (#66BB6A accent).      ║
 * ╚══════════════════════════════════════════════════════════════════╝ */

* {
    /* core palette */
    accent:        #66BB6Aff;   /* primary accent (matches active border / clock) */
    accent-dim:    #66BB6A22;   /* translucent accent for hover/selection fills   */
    accent-soft:   #66BB6A55;   /* subtle accent (borders, separators)            */

    base:        #212121cc;   /* window bg — translucent so Hypr blur shows     */
    base-solid:  #212121ff;
    surface:     #2C2C2Cee;   /* raised elements (input box, etc.)              */

    fg:          #ffffffff;   /* primary text (matches hyprlock font_color)     */
    fg-muted:    #ffffff80;   /* secondary / placeholder text                   */

    red:         #F44336ff;   /* urgent / error (matches fail_color)            */

    transparent: #00000000;
}
