# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms
font-family = IosevkaTerm Nerd Font Extended
font-size = 15
window-padding-x = 0
background = "#000000"
background-opacity = 0.67
mouse-scroll-multiplier = 0.5

# Quick terminal (Quake-style dropdown) — Linux support via wlr-layer-shell (1.2+)
quick-terminal-position = right
quick-terminal-size = 45%,40%
quick-terminal-screen = mouse
# Autohide MUST stay off: with it on the terminal hides itself on focus loss
# without the toggle state following, so the next SUPER+Q press "hides" an
# already-hidden terminal and it never comes back. Verified by screenshot.
quick-terminal-autohide = false
# Registered with the XDG GlobalShortcuts portal; the trigger below is only a
# suggestion — Hyprland binds it via `hyprctl globalshortcuts` / dispatcher `global`.
keybind = global:super+q=toggle_quick_terminal
