/* ╔══════════════════════════════════════════════════════════════════╗
 * ║  theme.rasi — main launcher look                                   ║
 * ║  Centered, translucent, cyan-accented to match Hyprland.          ║
 * ╚══════════════════════════════════════════════════════════════════╝ */

@import "colors.rasi"

* {
    font: "Adwaita Sans 12";

    background-color: transparent;
    text-color:       @fg;
}

/* ── Window ───────────────────────────────────────────────────────── */
window {
    transparency: "real";          /* needed for Hyprland blur underneath  */
    location:     center;
    anchor:       center;
    width:        640px;
    border:       1px;
    border-color: @cyan-soft;      /* echoes Hypr 1px cyan border          */
    border-radius: 14px;           /* matches hyprlock input rounding      */
    background-color: @base;
    padding:      0px;
    spacing:      0px;
}

mainbox {
    padding:  18px;
    spacing:  14px;
    children: [ inputbar, message, listview ];
}

/* ── Search bar ───────────────────────────────────────────────────── */
inputbar {
    background-color: @surface;
    border:           1px;
    border-color:     @cyan-soft;
    border-radius:    12px;
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @cyan;
    /* Adwaita Sans for text; the  glyph resolves via Pango fallback to a Nerd Font */
    font:             "Adwaita Sans 13";
    vertical-align:   0.5;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @fg-muted;
    cursor:            text;
    vertical-align:    0.5;
}

/* ── Optional message row (e.g. error/info) ───────────────────────── */
message {
    background-color: @surface;
    border:           1px;
    border-color:     @cyan-soft;
    border-radius:    12px;
    padding:          10px 16px;
}

textbox {
    text-color: @fg-muted;
}

/* ── Results list ─────────────────────────────────────────────────── */
listview {
    columns:      1;
    lines:        8;
    fixed-height: false;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    spacing:      4px;
}

element {
    padding:       10px 14px;
    spacing:       12px;
    border-radius: 10px;
    text-color:    @fg-muted;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @cyan-dim;
    text-color:       @cyan;
    border:           1px;
    border-color:     @cyan-soft;
}

element normal.urgent,
element selected.urgent,
element alternate.urgent {
    text-color: @red;
}

element-icon {
    size:           28px;
    vertical-align: 0.5;
}

element-text {
    vertical-align:   0.5;
    highlight:        bold #00ffcdff;   /* highlight matched chars in accent (literal: highlight rejects vars) */
    background-color: transparent;
    text-color:       inherit;
}
