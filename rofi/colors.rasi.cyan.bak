/* ╔══════════════════════════════════════════════════════════════════╗
 * ║  colors.rasi — shared palette                                      ║
 * ║  Mirrors the Hyprland / hyprlock cyan theme (#00ffcd accent).      ║
 * ╚══════════════════════════════════════════════════════════════════╝ */

* {
    /* core palette */
    cyan:        #00ffcdff;   /* primary accent (matches active border / clock) */
    cyan-dim:    #00ffcd22;   /* translucent accent for hover/selection fills   */
    cyan-soft:   #00ffcd55;   /* subtle accent (borders, separators)            */

    base:        #11181fcc;   /* window bg — translucent so Hypr blur shows     */
    base-solid:  #11181fff;
    surface:     #1a242dee;   /* raised elements (input box, etc.)              */

    fg:          #d0fff7ff;   /* primary text (matches hyprlock font_color)     */
    fg-muted:    #8a9a97ff;   /* secondary / placeholder text                   */

    red:         #ff4d6dff;   /* urgent / error (matches fail_color)            */

    transparent: #00000000;
}
