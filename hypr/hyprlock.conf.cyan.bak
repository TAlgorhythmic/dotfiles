# ╔══════════════════════════════════════════════════════════════════╗
# ║  hyprlock — lock screen for Hyprland                               ║
# ║  Blurred-desktop style, cyan accent (rgba(00ffcdee)).             ║
# ║  Triggered by hypridle via `loginctl lock-session`.               ║
# ╚══════════════════════════════════════════════════════════════════╝

general {
    hide_cursor        = true
    grace              = 2          # seconds of mouse/key after lock before input is required
    ignore_empty_input = true       # don't try to auth on a blank submit
}

# ── Background: live blurred screenshot of your desktop ─────────────
background {
    monitor    =
    path       = screenshot
    blur_passes = 3
    blur_size   = 8
    noise       = 0.0117
    contrast    = 0.9
    brightness  = 0.82
    vibrancy    = 0.17
}

# ── Big clock ───────────────────────────────────────────────────────
label {
    monitor   =
    text      = cmd[update:1000] echo "$(date '+%H:%M')"
    color     = rgba(00ffcdee)
    font_size = 112
    font_family = IosevkaTerm Nerd Font ExtraBold
    position  = 0, 220
    halign    = center
    valign    = center
    shadow_passes = 3
    shadow_size   = 6
}

# ── Date ────────────────────────────────────────────────────────────
label {
    monitor   =
    text      = cmd[update:18000000] echo "$(date '+%A, %d %B')"
    color     = rgba(d0fff7ff)
    font_size = 22
    font_family = IosevkaTerm Nerd Font
    position  = 0, 120
    halign    = center
    valign    = center
}

# ── Password input field ────────────────────────────────────────────
input-field {
    monitor      =
    size         = 320, 56
    outline_thickness = 2
    dots_size    = 0.28
    dots_spacing = 0.32
    dots_center  = true
    rounding     = 14

    outer_color  = rgba(00ffcdee)
    inner_color  = rgba(11181fdd)
    font_color   = rgba(d0fff7ff)
    check_color  = rgba(00ffcdee)   # while verifying
    fail_color   = rgba(ff4d6dee)   # wrong password

    placeholder_text = <span foreground="##8a9a97">  $USER</span>
    fail_text        = <span foreground="##ff4d6d">  $FAIL  ($ATTEMPTS)</span>

    position     = 0, -40
    halign       = center
    valign       = center
}

# ── Small hint line under the field ────────────────────────────────
label {
    monitor   =
    text      = 󰌾  locked
    color     = rgba(8a9a97cc)
    font_size = 13
    font_family = IosevkaTerm Nerd Font
    position  = 0, -120
    halign    = center
    valign    = center
}
