;; ─────────────────────────────────────────────
;;  Mouse acceleration profile picker
;; ─────────────────────────────────────────────

;; Currently applied profile (set by set-accel.sh)
(defpoll active-profile :interval "2s" :initial "adaptive"
  `cat $HOME/.cache/accel_profile 2>/dev/null || echo adaptive`)

;; Keyboard-highlighted profile (driven by nav.sh via `eww update`)
(defvar selected "adaptive")

(defwidget profile-btn [id label desc icon key]
  (button :class {"profile" + (active-profile == id ? " active" : "") + (selected == id ? " focused" : "")}
          :onclick "$HOME/.config/eww/scripts/nav.sh apply ${id}"
    (box :orientation "h" :space-evenly false :spacing 12 :valign "center"
      (label :class "p-icon" :text icon)
      (box :orientation "v" :space-evenly false :spacing 2 :hexpand true
        (label :class "p-title" :text label :halign "start")
        (label :class "p-desc"  :text desc  :halign "start" :wrap true :limit-width 40))
      (label :class "p-key" :text key)
      (label :class "p-check" :text {active-profile == id ? "" : ""}))))

(defwidget accel-content []
  (box :class "menu" :orientation "v" :space-evenly false :spacing 10
    (box :class "header" :orientation "h" :space-evenly false :valign "center"
      (label :class "title" :text "󰍽  Mouse Acceleration" :hexpand true :halign "start")
      (button :class "close" :onclick "$HOME/.config/eww/scripts/nav.sh cancel" "✕"))
    (profile-btn :id "adaptive" :icon "󰓅" :key "1" :label "Adaptive"
      :desc "Hyprland libinput adaptive · sensitivity -0.2")
    (profile-btn :id "custom" :icon "󰳽" :key "2" :label "Custom Curve"
      :desc "Hyprland native custom curve (step 1.9)")
    (label :class "hint" :halign "center"
      :text "↑↓/jk move   ↵ select   1·2 jump   esc close")))

(defwindow accel-menu
  :monitor 0
  :stacking "overlay"
  :focusable true
  :geometry (geometry :x "0" :y "0" :width "360px" :anchor "center")
  (accel-content))


;; ═════════════════════════════════════════════════════════════════════
;;  TASKBAR
;;  Left  : workspaces + active window title (Hyprland IPC, event-driven)
;;  Center: media (audacious) + clock/date
;;  Right : volume + network + power button
;; ═════════════════════════════════════════════════════════════════════

;; ── Data sources ─────────────────────────────────────────────────────
(deflisten WS    :initial "[]" "$HOME/.config/eww/scripts/hypr-workspaces.sh")
(deflisten WIN   :initial ""   "$HOME/.config/eww/scripts/hypr-window.sh")
(deflisten VOL   :initial '{"vol":0,"muted":false,"icon":"󰕾"}' "$HOME/.config/eww/scripts/volume.sh")
(defpoll  MEDIA  :interval "1s"   :initial '{"present":false,"status":"Stopped","title":"Nothing playing","artist":"","album":"","len":0,"pos":0,"frac":0,"pos_str":"0:00","len_str":"0:00","art":""}' "$HOME/.config/eww/scripts/media.sh")
(defpoll  NET    :interval "12s"  :initial '{"type":"wifi","icon":"󰤨","up":false,"ssid":"","label":"…"}' "$HOME/.config/eww/scripts/network.sh")
(defpoll  CLOCK  :interval "10s"  `date '+%H:%M'`)
(defpoll  CDATE  :interval "300s" `date '+%A, %d %B'`)

;; ── Left cluster ─────────────────────────────────────────────────────
(defwidget workspaces []
  (box :class "ws" :space-evenly false :spacing 5 :valign "center"
    (for w in WS
      (button :class {"ws-dot" + (w.active ? " active" : "") + (w.occupied ? " occupied" : "")}
              :onclick "hyprctl dispatch workspace ${w.id}"
        "${w.id}"))))

(defwidget wintitle []
  (label :class "wintitle" :halign "start" :limit-width 55 :show-truncated true
         :text {WIN == "" ? "Desktop" : WIN}))

;; ── Center cluster ───────────────────────────────────────────────────
(defwidget media-mini []
  (box :class "media" :visible {MEDIA.present} :space-evenly false :spacing 6 :valign "center"
    (button :class "m-btn"          :onclick "$HOME/.config/eww/scripts/media-ctl.sh prev" "󰒮")
    (button :class "m-btn m-play"   :onclick "$HOME/.config/eww/scripts/media-ctl.sh play"
            {MEDIA.status == "Playing" ? "󰏤" : "󰐊"})
    (button :class "m-btn"          :onclick "$HOME/.config/eww/scripts/media-ctl.sh next" "󰒬")
    (button :class "m-title"        :onclick "eww --config $HOME/.config/eww open --toggle media-popup"
      (label :limit-width 26 :show-truncated true
             :text {MEDIA.status == "Playing" || MEDIA.status == "Paused"
                      ? (MEDIA.artist != "" ? "${MEDIA.title}  ·  ${MEDIA.artist}" : MEDIA.title)
                      : "Nothing playing"}))))

(defwidget clock []
  (button :class "clock" :onclick "eww --config $HOME/.config/eww open --toggle media-popup"
    (box :space-evenly false :spacing 8 :valign "center"
      (label :class "clock-time" :text CLOCK)
      (label :class "clock-date" :text CDATE))))

;; ── Right cluster ────────────────────────────────────────────────────
(defwidget volume []
  (eventbox :class "vol-box"
            :onscroll "$HOME/.config/eww/scripts/vol.sh {}"
            :onclick  "$HOME/.config/eww/scripts/vol.sh mute"
    (box :class {"vol" + (VOL.muted ? " muted" : "")} :space-evenly false :spacing 7 :valign "center"
      (label :class "vol-ico" :text {VOL.icon})
      (label :class "vol-pct" :text "${VOL.vol}%"))))

(defwidget network []
  (box :class {"net" + (NET.up ? " up" : " down")} :space-evenly false :spacing 7 :valign "center"
       :tooltip {NET.label}
    (label :class "net-ico" :text {NET.icon})
    (label :class "net-ssid" :limit-width 18 :show-truncated true
           :text {NET.up ? NET.label : "Off"})))

(defwidget powerbtn []
  (button :class "powerbtn" :onclick "eww --config $HOME/.config/eww open --toggle powermenu" "󰐥"))

;; ── Bar assembly ─────────────────────────────────────────────────────
(defwidget bar-content []
  (centerbox :class "bar" :orientation "h"
    (box :class "bar-left"   :halign "start"  :space-evenly false :spacing 16
      (workspaces) (wintitle))
    (box :class "bar-center" :halign "center" :space-evenly false :spacing 18
      (media-mini) (clock))
    (box :class "bar-right"  :halign "end"    :space-evenly false :spacing 14
      (volume) (network) (powerbtn))))

(defwindow bar
  :monitor 0
  :stacking "fg"
  :exclusive true
  :geometry (geometry :x "0" :y "0" :width "100%" :height "38px" :anchor "top center")
  (bar-content))


;; ═════════════════════════════════════════════════════════════════════
;;  MEDIA POPUP — album art, slider, transport
;; ═════════════════════════════════════════════════════════════════════
(defwidget media-popup-content []
  (box :class "mpop" :orientation "v" :space-evenly false :spacing 12
    (box :class "mpop-art" :halign "center"
      (overlay
        (box :class "mpop-art-ph" :width 200 :height 200
          (label :class "mpop-art-icon" :text "󰎈"))
        (box :visible {MEDIA.art != ""}
          (image :class "mpop-art-img" :path {MEDIA.art != "" ? MEDIA.art : "/dev/null"}
                 :image-width 200 :image-height 200))))
    (box :orientation "v" :space-evenly false :spacing 2 :halign "center"
      (label :class "mpop-title"  :limit-width 32 :show-truncated true :text {MEDIA.title})
      (label :class "mpop-artist" :limit-width 38 :show-truncated true
             :text {MEDIA.artist != "" ? MEDIA.artist : "—"}))
    (box :class "mpop-seek" :orientation "v" :space-evenly false :spacing 3
      (scale :class "mpop-scale" :value {MEDIA.frac * 100} :min 0 :max 100 :round-digits 0
             :onchange "$HOME/.config/eww/scripts/media-ctl.sh seekpct {}")
      (box :space-evenly false
        (label :class "mpop-time" :hexpand true :halign "start" :text {MEDIA.pos_str})
        (label :class "mpop-time" :halign "end" :text {MEDIA.len_str})))
    (box :class "mpop-ctl" :halign "center" :space-evenly false :spacing 22
      (button :class "mpop-btn"            :onclick "$HOME/.config/eww/scripts/media-ctl.sh prev" "󰒮")
      (button :class "mpop-btn mpop-play"  :onclick "$HOME/.config/eww/scripts/media-ctl.sh play"
              {MEDIA.status == "Playing" ? "󰏤" : "󰐊"})
      (button :class "mpop-btn"            :onclick "$HOME/.config/eww/scripts/media-ctl.sh next" "󰒬"))))

(defwindow media-popup
  :monitor 0
  :stacking "overlay"
  :focusable false
  :geometry (geometry :x "0" :y "46px" :width "280px" :anchor "top center")
  (media-popup-content))


;; ═════════════════════════════════════════════════════════════════════
;;  POWER MENU
;; ═════════════════════════════════════════════════════════════════════
(defwidget pm-item [icon label action]
  (button :class "pm-item" :onclick "$HOME/.config/eww/scripts/powermenu.sh ${action}"
    (box :orientation "v" :space-evenly false :spacing 8 :halign "center"
      (label :class "pm-ico" :text icon)
      (label :class "pm-lbl" :text label))))

(defwidget powermenu-content []
  (eventbox :class "pm-backdrop" :onclick "$HOME/.config/eww/scripts/powermenu.sh cancel"
    (box :halign "center" :valign "center"
      (eventbox :onclick "true"
        (box :class "pm-card" :orientation "v" :space-evenly false :spacing 18
          (label :class "pm-head" :text "󰐥   Power")
          (box :space-evenly true :spacing 16
            (pm-item :icon "󰌾" :label "Lock"    :action "lock")
            (pm-item :icon "󰍃" :label "Logout"  :action "logout")
            (pm-item :icon "󰒲" :label "Suspend" :action "suspend"))
          (box :space-evenly true :spacing 16
            (pm-item :icon "󰜉" :label "Reboot"   :action "reboot")
            (pm-item :icon "󰐥" :label "Shutdown" :action "shutdown")
            (pm-item :icon "󰅖" :label "Cancel"   :action "cancel")))))))

(defwindow powermenu
  :monitor 0
  :stacking "overlay"
  :focusable true
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (powermenu-content))
